{
  "id": "imperatives",
  "title": "Câu mệnh lệnh và Let's",
  "order": 14,
  "sessions": 1,
  "explain": [
    {
      "vi": "Câu mệnh lệnh dùng để bảo ai làm gì. Ta chỉ dùng động từ nguyên mẫu, không có chủ ngữ và không thêm s hay ing. Thêm please để nói lịch sự hơn.",
      "examples": [
        {
          "en": "Sit on the chair.",
          "vi": "Hãy ngồi lên ghế."
        },
        {
          "en": "Please help me.",
          "vi": "Làm ơn giúp tôi."
        }
      ]
    },
    {
      "vi": "Để bảo ai đừng làm gì, ta dùng Don't + động từ nguyên mẫu.",
      "examples": [
        {
          "en": "Don't sit on the table.",
          "vi": "Đừng ngồi lên bàn."
        },
        {
          "en": "Don't drink the water.",
          "vi": "Đừng uống nước này."
        }
      ]
    },
    {
      "vi": "Let's + động từ nguyên mẫu dùng để rủ ai cùng làm gì (\"chúng ta hãy...\").",
      "examples": [
        {
          "en": "Let's sing a song.",
          "vi": "Chúng ta hãy hát một bài hát."
        },
        {
          "en": "Let's paint the house.",
          "vi": "Chúng ta hãy sơn ngôi nhà."
        }
      ]
    }
  ],
