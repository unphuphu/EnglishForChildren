  "explain": [
    {
      "vi": "Can nghĩa là \"có thể / biết (làm gì)\". Sau can ta dùng động từ nguyên mẫu: không thêm s, không thêm ing, không thêm to. Can giữ nguyên với mọi chủ ngữ.",
      "examples": [
        { "en": "I can sing.", "vi": "Tôi biết hát." },
        { "en": "She can dance.", "vi": "Cô ấy biết nhảy." }
      ]
    },
    {
      "vi": "Để nói \"không thể\", ta dùng can't (hoặc cannot) rồi vẫn dùng động từ nguyên mẫu.",
      "examples": [
        { "en": "The baby can't dance.", "vi": "Em bé chưa biết nhảy." },
        { "en": "He can't paint a cat.", "vi": "Anh ấy không vẽ được con mèo." }
      ]
    },
    {
      "vi": "Để hỏi, ta đưa can lên đầu câu: Can + chủ ngữ + động từ? Trả lời ngắn: Yes, I can. / No, I can't.",
      "examples": [
        { "en": "Can you sing a song?", "vi": "Bạn có hát được một bài hát không?" },
        { "en": "Can the cat paint?", "vi": "Con mèo có vẽ được không?" }
      ]
    }
  ],
