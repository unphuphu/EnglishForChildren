{
  "id": "time-prepositions",
  "title": "Giới từ chỉ thời gian: on / in",
  "order": 17,
  "sessions": 1,
  "explain": [
    {
      "vi": "Dùng on với các thứ trong tuần: on Monday, on Sunday, on Saturday. Dùng in với mùa và tháng: in summer, in winter, in January.",
      "examples": [
        {
          "en": "I play football on Sunday.",
          "vi": "Tôi chơi bóng đá vào Chủ nhật."
        },
        {
          "en": "We play football in summer.",
          "vi": "Chúng tôi chơi bóng đá vào mùa hè."
        }
      ]
    },
    {
      "vi": "Các giới từ này đứng trước từ chỉ thời gian và thường nằm ở cuối câu. Không dùng at hay in với thứ trong tuần, không dùng on với mùa.",
      "examples": [
        {
          "en": "She works on Monday.",
          "vi": "Cô ấy làm việc vào thứ Hai."
        },
        {
          "en": "My sister dances in summer.",
          "vi": "Chị gái tôi nhảy vào mùa hè."
        }
      ]
    },
    {
      "vi": "Câu phủ định và câu hỏi giữ nguyên giới từ: She doesn't work on Sunday. Do you play football on Saturday?",
      "examples": [
        {
          "en": "She doesn't work on Sunday.",
          "vi": "Cô ấy không làm việc vào Chủ nhật."
        },
        {
          "en": "Do you play football on Saturday?",
          "vi": "Bạn có chơi bóng đá vào thứ Bảy không?"
        }
      ]
    }
  ],
